root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.{cs,ps1,py}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

# Windows PowerShell 5.1 reads Korean text correctly only from UTF-8 with a BOM.
[{scripts/{prepare-release,release-notes},installer/install}.ps1]
charset = utf-8-bom

# cmd.exe scripts ship inside the release ZIP.
[*.bat]
end_of_line = crlf
