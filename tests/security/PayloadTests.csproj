<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- Some shared fake-server hooks are exercised only by the client suite. -->
    <NoWarn>$(NoWarn);CS0649</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="PayloadTests.cs" />
    <Compile Include="../FakeServer.cs" Link="FakeServer.cs" />
    <Compile Include="../Stubs.cs" Link="Stubs.cs" />
    <Compile Include="../../src/PartyChatClient*.cs" Link="%(Filename)%(Extension)" />
    <Compile Include="../../src/PartyProtocol.cs" Link="PartyProtocol.cs" />
    <Compile Include="../../src/ChatModels.cs" Link="ChatModels.cs" />
    <Compile Include="../../src/RemotePayload.cs" Link="RemotePayload.cs" />
  </ItemGroup>
</Project>
